#!/usr/bin/env bash
#
# chatos-audio — 인스턴스에서 쓰는 명령
#
#   chatos-audio          최신으로 받고 설치·실행 (몇 번을 쳐도 안전)
#   chatos-audio status   speaches·터널 응답, 최근 로그
#   chatos-audio models   speaches 가 쓸 수 있는 모델 목록
#   chatos-audio test     한국어 오디오 한 건 전사 (인자로 파일 경로)
#   chatos-audio logs     로그 따라가기 (Ctrl+C 로 나옴)
#   chatos-audio stop     정지

set -uo pipefail

ENV_FILE="/etc/chatos-audio.env"
# shellcheck disable=SC1090
[ -f "$ENV_FILE" ] && source "$ENV_FILE"

# **INSTALL_ROOT 를 쓰지 않습니다.** 이미지 생성 쪽 계정 환경변수가 그 이름을
# 점유하고 있어서, 쓰면 /workspace/chatos-image 를 가리킵니다.
AUDIO_ROOT="${AUDIO_ROOT:-/workspace/chatos-audio}"
# shellcheck disable=SC1090
[ -f "$AUDIO_ROOT/scripts/defaults.sh" ] && source "$AUDIO_ROOT/scripts/defaults.sh"

BASE="http://127.0.0.1:$SPEACHES_PORT"

auth=()
[ -n "$AUDIO_GPU_TOKEN" ] && auth=(-H "Authorization: Bearer $AUDIO_GPU_TOKEN")

case "${1:-run}" in

run)
    exec bash "$AUDIO_ROOT/go.sh"
    ;;

status)
    echo "── speaches ──"
    if curl -fsS --max-time 5 "$BASE/health" >/dev/null 2>&1; then
        echo "  health   200"
    else
        echo "  health   응답 없음"
    fi
    for n in speaches tunnel; do
        p="$RUN_DIR/$n.pid"
        if [ -f "$p" ] && kill -0 "$(cat "$p")" 2>/dev/null; then
            echo "  $n  PID $(cat "$p")  살아 있음"
        else
            echo "  $n  없음"
        fi
    done

    echo
    echo "── 로그 (없으면 그 앞 단계에서 멈춘 것) ──"
    for f in install.log speaches.log warmup.log warmup.err tunnel.log; do
        if [ -f "$LOG_DIR/$f" ]; then
            printf "  %-14s %s\n" "$f" "$(wc -l <"$LOG_DIR/$f") 줄"
        else
            printf "  %-14s **없음**\n" "$f"
        fi
    done

    echo
    echo "── HF 캐시 ──"
    hub="${HF_HUB_CACHE:-${HF_HOME:-/workspace/.hf_home}/hub}"
    if [ -d "$hub" ]; then
        echo "  $hub  ($(du -sh "$hub" 2>/dev/null | cut -f1))"
        find "$hub" -maxdepth 1 -name 'models--*' -printf '    %f\n' 2>/dev/null | head -10
        [ -z "$(find "$hub" -maxdepth 1 -name 'models--*' 2>/dev/null)" ] \
            && echo "    **받아둔 모델 없음** — chatos-audio pull"
    else
        echo "  $hub  **없음** — 이러면 /v1/models 도 500 입니다"
    fi

    echo
    echo "── GPU ──"
    nvidia-smi --query-gpu=name,memory.used,memory.total,utilization.gpu \
        --format=csv,noheader 2>/dev/null || echo "  nvidia-smi 없음"
    ;;

models)
    # 로컬 캐시에 **받아둔** 모델입니다. 비어 있으면 아직 안 받은 것이고,
    # speaches 는 요청이 와도 자동으로 받지 않습니다 — 500 CacheNotFound 가 납니다.
    curl -sS -w '\n[HTTP %{http_code}]\n' "${auth[@]}" "$BASE/v1/models"
    ;;

registry)
    # 내려받을 수 있는 모델 목록. 여기서 정확한 id 를 확인하세요.
    curl -sS "${auth[@]}" "$BASE/v1/registry" \
        | python3 -c 'import json,sys
d=json.load(sys.stdin)
items=d.get("data", d if isinstance(d,list) else [])
q=(sys.argv[1] if len(sys.argv)>1 else "").lower()
for m in items:
    i=m.get("id","") if isinstance(m,dict) else str(m)
    if not q or q in i.lower(): print(i)' "${2:-}"
    ;;

pull)
    m="${2:-$AUDIO_MODEL}"
    echo "내려받기: $m"
    cd "${SPEACHES_DIR:-/workspace/speaches}" || exit 1
    HF_HOME="${HF_HOME:-/workspace/.hf_home}" \
    HF_HUB_CACHE="${HF_HUB_CACHE:-/workspace/.hf_home/hub}" \
        uv run python -c "
import sys
from huggingface_hub import snapshot_download
print('받은 위치:', snapshot_download('$m'))"
    ;;

test)
    f="${2:-}"
    [ -n "$f" ] && [ -f "$f" ] || { echo "사용법: chatos-audio test <오디오파일>"; exit 1; }
    echo "모델 $AUDIO_MODEL · 파일 $f"
    start=$(date +%s)
    curl -fsS "${auth[@]}" \
        -F "file=@$f" -F "model=$AUDIO_MODEL" -F "response_format=verbose_json" \
        "$BASE/v1/audio/transcriptions" | python3 -m json.tool
    echo "── 걸린 시간: $(( $(date +%s) - start ))초"
    ;;

logs)
    tail -f "$LOG_DIR"/*.log
    ;;

stop)
    for n in speaches tunnel; do
        p="$RUN_DIR/$n.pid"
        if [ -f "$p" ]; then
            pid="$(cat "$p")"
            kill "$pid" 2>/dev/null && echo "$n 정지 (PID $pid)"
            rm -f "$p"
        fi
    done
    ;;

*)
    cat <<'USAGE'
chatos-audio                     최신으로 받고 설치·실행
chatos-audio status              응답 · 프로세스 · 로그 · GPU · HF 캐시
chatos-audio registry [검색어]   **내려받을 수 있는** 모델 (정확한 id 확인용)
chatos-audio models              **받아둔** 로컬 모델
chatos-audio pull [모델id]       모델 내려받기
chatos-audio test <오디오파일>   전사 한 건 + 걸린 시간
chatos-audio logs                로그 따라가기
chatos-audio stop                정지
USAGE
    exit 1
    ;;
esac
