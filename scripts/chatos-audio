#!/usr/bin/env bash
#
# chatos-audio — 인스턴스에서 쓰는 명령
#
#   chatos-audio          최신으로 받고 설치·실행 (몇 번을 쳐도 안전)
#   chatos-audio status   speaches·터널 응답, 최근 로그
#   chatos-audio models   speaches 가 쓸 수 있는 모델 목록
#   chatos-audio test     한국어 오디오 한 건 전사 (인자로 파일 경로)
#   chatos-audio logs     로그 따라가기 (Ctrl+C 로 나옴)
#   chatos-audio stop     정지

set -uo pipefail

ENV_FILE="/etc/chatos-audio.env"
# shellcheck disable=SC1090
[ -f "$ENV_FILE" ] && source "$ENV_FILE"

# **INSTALL_ROOT 를 쓰지 않습니다.** 이미지 생성 쪽 계정 환경변수가 그 이름을
# 점유하고 있어서, 쓰면 /workspace/chatos-image 를 가리킵니다.
AUDIO_ROOT="${AUDIO_ROOT:-/workspace/chatos-audio}"
# shellcheck disable=SC1090
[ -f "$AUDIO_ROOT/scripts/defaults.sh" ] && source "$AUDIO_ROOT/scripts/defaults.sh"

BASE="http://127.0.0.1:$SPEACHES_PORT"

# 인스턴스는 python3 인데 개발 PC(윈도우)는 python 뿐입니다. **로컬에서
# 돌려볼 수 없으면 이 스크립트는 인스턴스에서 처음 돌아갑니다.**
PY="$(command -v python3 || command -v python || true)"

auth=()
[ -n "$AUDIO_GPU_TOKEN" ] && auth=(-H "Authorization: Bearer $AUDIO_GPU_TOKEN")

case "${1:-run}" in

run)
    exec bash "$AUDIO_ROOT/go.sh"
    ;;

status)
    echo "── speaches ──"
    if curl -fsS --max-time 5 "$BASE/health" >/dev/null 2>&1; then
        echo "  health   200"
    else
        echo "  health   응답 없음"
    fi
    # **매니저가 밖에서 닿는 자리입니다.** 여기가 죽으면 speaches 가 멀쩡해도
    # 서비스는 죽은 것이라 따로 봅니다. 상류 상태도 같이 실려 옵니다.
    if m="$(curl -sS --max-time 3 "http://127.0.0.1:${MANAGER_PORT:-8100}/health" 2>/dev/null)"; then
        echo "  매니저   $m"
    else
        echo "  매니저   응답 없음 (포트 ${MANAGER_PORT:-8100})"
    fi
    for n in manager speaches tunnel; do
        p="$RUN_DIR/$n.pid"
        if [ -f "$p" ] && kill -0 "$(cat "$p")" 2>/dev/null; then
            echo "  $n  PID $(cat "$p")  살아 있음"
        else
            echo "  $n  없음"
        fi
    done

    echo
    echo "── 로그 (없으면 그 앞 단계에서 멈춘 것) ──"
    for f in install.log speaches.log manager.log warmup.log warmup.err tunnel.log; do
        if [ -f "$LOG_DIR/$f" ]; then
            printf "  %-14s %s\n" "$f" "$(wc -l <"$LOG_DIR/$f") 줄"
        else
            printf "  %-14s **없음**\n" "$f"
        fi
    done

    echo
    echo "── HF 캐시 ──"
    hub="${HF_HUB_CACHE:-${HF_HOME:-/workspace/.hf_home}/hub}"
    if [ -d "$hub" ]; then
        echo "  $hub  ($(du -sh "$hub" 2>/dev/null | cut -f1))"
        find "$hub" -maxdepth 1 -name 'models--*' -printf '    %f\n' 2>/dev/null | head -10
        [ -z "$(find "$hub" -maxdepth 1 -name 'models--*' 2>/dev/null)" ] \
            && echo "    **받아둔 모델 없음** — chatos-audio pull"
    else
        echo "  $hub  **없음** — 이러면 /v1/models 도 500 입니다"
    fi

    echo
    echo "── GPU ──"
    nvidia-smi --query-gpu=name,memory.used,memory.total,utilization.gpu \
        --format=csv,noheader 2>/dev/null || echo "  nvidia-smi 없음"
    ;;

models)
    # 로컬 캐시에 **받아둔** 모델입니다. 비어 있으면 아직 안 받은 것이고,
    # speaches 는 요청이 와도 자동으로 받지 않습니다 — 500 CacheNotFound 가 납니다.
    curl -sS -w '\n[HTTP %{http_code}]\n' "${auth[@]}" "$BASE/v1/models"
    ;;

registry)
    # 내려받을 수 있는 모델 목록. 여기서 정확한 id 를 확인하세요.
    curl -sS "${auth[@]}" "$BASE/v1/registry" \
        | python3 -c 'import json,sys
d=json.load(sys.stdin)
items=d.get("data", d if isinstance(d,list) else [])
q=(sys.argv[1] if len(sys.argv)>1 else "").lower()
for m in items:
    i=m.get("id","") if isinstance(m,dict) else str(m)
    if not q or q in i.lower(): print(i)' "${2:-}"
    ;;

pull)
    m="${2:-$AUDIO_MODEL}"
    echo "내려받기: $m"
    cd "${SPEACHES_DIR:-/workspace/speaches}" || exit 1
    HF_HOME="${HF_HOME:-/workspace/.hf_home}" \
    HF_HUB_CACHE="${HF_HUB_CACHE:-/workspace/.hf_home/hub}" \
        uv run python -c "
import sys
from huggingface_hub import snapshot_download
print('받은 위치:', snapshot_download('$m'))"
    ;;

test)
    # **안내 문구는 stderr 로 냅니다.** stdout 은 순수 JSON 이어야 파이프에
    # 태우거나 파일로 받을 수 있습니다.
    f="${2:-}"
    [ -n "$f" ] && [ -f "$f" ] || { echo "사용법: chatos-audio test <오디오파일>" >&2; exit 1; }
    echo "모델 $AUDIO_MODEL · 파일 $f" >&2
    start=$(date +%s)
    curl -sS "${auth[@]}" \
        -F "file=@$f" -F "model=$AUDIO_MODEL" -F "response_format=verbose_json" \
        "$BASE/v1/audio/transcriptions"
    echo >&2
    echo "── 걸린 시간: $(( $(date +%s) - start ))초" >&2
    ;;

text)
    # 품질을 눈으로 볼 때. 전사 텍스트만 파일로 뽑습니다.
    f="${2:-}"
    [ -n "$f" ] && [ -f "$f" ] || { echo "사용법: chatos-audio text <오디오파일> [출력.txt]" >&2; exit 1; }
    out="${3:-${f%.*}.txt}"
    echo "모델 $AUDIO_MODEL · 파일 $f → $out" >&2
    start=$(date +%s)
    curl -sS "${auth[@]}" \
        -F "file=@$f" -F "model=$AUDIO_MODEL" -F "response_format=verbose_json" \
        "$BASE/v1/audio/transcriptions" \
      | python3 -c "
import json,sys
d = json.load(sys.stdin)
if 'text' not in d:
    print('전사 실패:', json.dumps(d, ensure_ascii=False)[:500], file=sys.stderr); sys.exit(1)
open('$out','w',encoding='utf-8').write(d['text'])
print(f\"길이 {d.get('duration')}초 · 글자수 {len(d['text'])}\", file=sys.stderr)
print(d['text'][:300], file=sys.stderr)"
    echo "── 걸린 시간: $(( $(date +%s) - start ))초 → $out" >&2
    ;;

compare)
    # **2-9 대조 — 분할 있이/없이 같은 파일.**
    #
    # 이 명령이 존재하는 이유: 손으로 두 번 돌리고 눈으로 비교하면 **매번 다른
    # 조건으로 재게 됩니다.** 같은 파일·같은 프롬프트를 두 경로에 태우고,
    # 눈으로 보기 어려운 것(반복 환각)은 세어서 냅니다.
    #
    #   없이 = speaches 직접 (통짜)
    #   있이 = 매니저 경유 — **매니저가 AUDIO_SPLIT=1 로 떠 있어야 합니다**
    #
    # 판정은 셋입니다 — 반복이 줄었나 · 경계에서 말이 깨졌나 · 91초 안인가.
    f="${2:-}"
    [ -n "$f" ] && [ -f "$f" ] || {
        echo "사용법: chatos-audio compare <오디오파일> [프롬프트]" >&2; exit 1; }
    prompt="${3:-}"
    stem="${f%.*}"

    mgr="http://127.0.0.1:${MANAGER_PORT:-8100}"
    if ! curl -sS --max-time 3 "$mgr/health" >/dev/null 2>&1; then
        echo "!! 매니저($mgr)가 응답하지 않습니다. 분할 쪽을 못 잽니다" >&2
        exit 1
    fi
    if ! curl -sS --max-time 3 "$mgr/health" | grep -q '"split":true'; then
        echo "!! 매니저가 AUDIO_SPLIT=0 으로 떠 있습니다. 두 쪽이 같은 결과가 나옵니다" >&2
        echo "   AUDIO_SPLIT=1 을 /etc/chatos-audio.env 에 넣고 chatos-audio 를 다시 도세요" >&2
        exit 1
    fi

    args=(-F "model=$AUDIO_MODEL" -F "response_format=verbose_json")
    [ -n "$prompt" ] && args+=(-F "prompt=$prompt")

    echo "── 없이 (통짜, speaches 직접) ──" >&2
    t0=$(date +%s)
    curl -sS "${auth[@]}" -F "file=@$f" "${args[@]}" \
        "$BASE/v1/audio/transcriptions" > "$stem.whole.json"
    whole_secs=$(( $(date +%s) - t0 ))
    echo "   ${whole_secs}초 → $stem.whole.json" >&2

    echo "── 있이 (분할, 매니저 경유) ──" >&2
    t0=$(date +%s)
    curl -sS "${auth[@]}" -F "file=@$f" "${args[@]}" \
        "$mgr/v1/audio/transcriptions" > "$stem.split.json"
    split_secs=$(( $(date +%s) - t0 ))
    echo "   ${split_secs}초 → $stem.split.json" >&2

    "$PY" - "$stem.whole.json" "$stem.split.json" "$whole_secs" "$split_secs" <<'PY'
import json, re, sys
from collections import Counter

def load(path):
    with open(path, encoding="utf-8") as fh:
        d = json.load(fh)
    if "text" not in d:
        print(f"!! {path} 에 text 가 없습니다: {json.dumps(d, ensure_ascii=False)[:300]}")
        sys.exit(1)
    return d

def repeats(text):
    """연속 반복을 셉니다.

    **환각의 대표 증상이 이것입니다** - 12차에서 `핵심폰드로 이사하고 그거를`
    이 세 번 이어졌습니다. 어절 3개짜리 창을 밀면서 바로 다음에 같은 것이
    또 오는 경우를 셉니다. 정상 발화에도 반복은 있으니 **0 이 목표가 아니라
    두 쪽의 차이가 판정**입니다.
    """
    words = re.sub(r"\s+", " ", text).strip().split(" ")
    grams = [" ".join(words[i:i+3]) for i in range(len(words) - 2)]
    runs, worst, worst_gram = 0, 0, ""
    i = 0
    while i < len(grams) - 3:
        if grams[i] == grams[i+3]:
            n = 1
            while i + 3*(n+1) < len(grams) and grams[i] == grams[i + 3*(n+1)]:
                n += 1
            runs += 1
            if n + 1 > worst:
                worst, worst_gram = n + 1, grams[i]
            i += 3 * (n + 1)
        else:
            i += 1
    return runs, worst, worst_gram

whole, split = load(sys.argv[1]), load(sys.argv[2])
w_secs, s_secs = int(sys.argv[3]), int(sys.argv[4])

print()
print(f"{'':14} {'없이(통짜)':>14} {'있이(분할)':>14}")
print(f"{'-'*46}")
print(f"{'처리 시간':14} {str(w_secs)+'초':>14} {str(s_secs)+'초':>14}")
print(f"{'글자 수':14} {len(whole['text']):>14} {len(split['text']):>14}")
print(f"{'세그먼트':14} {len(whole.get('segments') or []):>14} {len(split.get('segments') or []):>14}")
print(f"{'duration':14} {str(whole.get('duration')):>14} {str(split.get('duration')):>14}")

wr, ww, wg = repeats(whole["text"])
sr, ss, sg = repeats(split["text"])
print(f"{'반복 구간':14} {wr:>14} {sr:>14}")
print(f"{'최대 연속반복':14} {str(ww)+'회':>14} {str(ss)+'회':>14}")
print()
if wg: print(f"  없이 최악: {wg[:60]}")
if sg: print(f"  있이 최악: {sg[:60]}")

print()
print("판정 기준")
print("  1. 반복이 줄었나          - 이게 분할을 되살린 근거입니다")
print("  2. 처리 시간이 91초 안인가 - 품질이 좋아져도 넘기면 못 씁니다")
print("  3. duration 이 같은가      - 다르면 차감이 틀어집니다")
print("  4. 경계에서 말이 깨졌나    - **이건 눈으로 봐야 합니다.**")
print("     매니저 로그의 경계 시각 근처를 두 파일에서 비교하세요")
print("     (정각 절단 횟수도 로그에 있습니다 - 크면 무음 기준을 낮추세요)")
PY
    ;;

logs)
    tail -f "$LOG_DIR"/*.log
    ;;

stop)
    for n in manager speaches tunnel; do
        p="$RUN_DIR/$n.pid"
        if [ -f "$p" ]; then
            pid="$(cat "$p")"
            kill "$pid" 2>/dev/null && echo "$n 정지 (PID $pid)"
            rm -f "$p"
        fi
    done
    ;;

*)
    cat <<'USAGE'
chatos-audio                     최신으로 받고 설치·실행
chatos-audio status              응답 · 프로세스 · 로그 · GPU · HF 캐시
chatos-audio registry [검색어]   **내려받을 수 있는** 모델 (정확한 id 확인용)
chatos-audio models              **받아둔** 로컬 모델
chatos-audio pull [모델id]       모델 내려받기
chatos-audio test <오디오파일>   전사 한 건 (stdout 은 순수 JSON)
chatos-audio text <오디오파일>   전사 텍스트만 .txt 로 — **품질 볼 때**
chatos-audio compare <파일> [프롬프트]
                                 **분할 있이/없이 대조 (2-9).** 반복 환각을 세어서 냅니다
chatos-audio logs                로그 따라가기
chatos-audio stop                정지
USAGE
    exit 1
    ;;
esac
